# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# Required — from your Supabase project: Project Settings → API Keys
# (or click "Connect" at the top of the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key. A newer "publishable" key (sb_publishable_...) works here too.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — enables the Map page. Get a public token (pk....) at
# https://account.mapbox.com/access-tokens/ . Leave blank to hide the map.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
